# Email account used by the backend
EMAIL_USER=your_email@yourdomain.com
EMAIL_PASSWORD=your_hostinger_app_password

# Hostinger SMTP settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/test?retryWrites=true&w=majority

# JWT secret used for token signing and verification
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret

# Firebase Admin SDK credentials
# Keep FIREBASE_PRIVATE_KEY on one line and preserve the literal \n sequences.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n

# Cloudinary image storage credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Generative AI chatbot key
GEMINI_API_KEY=your_google_ai_api_key

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Frontend URLs used in password-reset links
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL_DEV=http://localhost:5173

# Default image URLs
PLACEHOLDER_IMAGE_URL=https://github.com/your-account/your-backend/blob/main/logo.png?raw=true

# Server settings
PORT=3000
NODE_ENV=development
